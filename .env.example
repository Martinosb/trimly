# Trimly Environment Variables Example

# Supabase (Local by default)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:moseiboakye@st.knust.edu.gh

# Payment Providers (Mocked by default behind interface)
MOCK_PAYMENT_MODE=true
PAYSTACK_SECRET_KEY=mock_paystack_secret_key
PAYSTACK_PUBLIC_KEY=mock_paystack_public_key
HUBTEL_CLIENT_ID=mock_hubtel_client_id
HUBTEL_CLIENT_SECRET=mock_hubtel_client_secret

# SMS / WhatsApp Notifications (Mocked by default behind interface)
MOCK_SMS_MODE=true
ARKESEL_API_KEY=mock_arkesel_api_key
ARKESEL_SENDER_ID=Trimly
